# Ignore OS-specific files (e.g., Mac settings)
.DS_Store
Thumbs.db

# Ignore Python runtime and cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Ignore Ansible retry files (created when a playbook fails)
*.retry

# Ignore sensitive credential files
*.pem
*.key
secrets.txt
ansible_vault_password.txt

# Ignore local environment or configuration files
.env
